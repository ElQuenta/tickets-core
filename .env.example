# Copiar como .env en la raíz del proyecto. No guardar credenciales reales aquí.
# Mantener una sola ConnectionStrings__DefaultConnection activa.
# Las comillas simples conservan $, #, espacios y barras como texto literal.

# Desarrollo con Windows LocalDB (requiere tener LocalDB instalado):
ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=TicketsCore;Trusted_Connection=True;MultipleActiveResultSets=true'

# SQL Server con usuario y contraseña: reemplazar la línea activa por esta y editarla.
# ConnectionStrings__DefaultConnection='Server=SERVIDOR,1433;Database=TicketsCore;User Id=USUARIO;Password=CONTRASENA;Encrypt=True;TrustServerCertificate=False'

# SQL Server con autenticación integrada de Windows:
# ConnectionStrings__DefaultConnection='Server=SERVIDOR,1433;Database=TicketsCore;Integrated Security=True;Encrypt=True;TrustServerCertificate=False'
